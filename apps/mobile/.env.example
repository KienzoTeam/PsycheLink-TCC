# OPCIONAL: normalmente não é preciso configurar nada.
# Em dev o app detecta automaticamente o IP do PC que roda o Expo (`npx expo start`,
# modo LAN padrão) e usa esse mesmo host para a API na porta 3000.
#
# Defina EXPO_PUBLIC_API_URL apenas se:
# - usar `expo start --tunnel` (o host do túnel não serve a porta da API)
# - apontar para um servidor diferente (ex.: produção)
# EXPO_PUBLIC_API_URL=http://192.168.0.XX:3000
