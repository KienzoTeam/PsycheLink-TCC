{
  "expo": {
    "name": "PsycheLink",
    "slug": "psychelink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#efe5fd",
        "foregroundImage": "./src/assets/android-icon-foreground.png",
        "backgroundImage": "./src/assets/android-icon-background.png",
        "monochromeImage": "./src/assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kienzoteam.psychelink",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#efe5fd",
          "dark": {
            "image": "./src/assets/splash-icon-dark.png",
            "backgroundColor": "#1e1e2e"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assets/notificacao-icone.png",
          "color": "#8839ef"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a048be29-8418-4b14-8927-901770007549"
      }
    },
    "owner": "imfenyx"
  }
}
