# URL de conexão com SSL exigido
DATABASE_URL=""

# Chave secreta longa e complexa para o JWT
JWT_SECRET=""

# String aleatória usada como pepper no hash dos códigos OTP de e-mail
EMAIL_PEPPER=""

# SMTP para envio dos códigos (Gmail c/ senha de app, Resend, Brevo...).
# Sem SMTP_HOST, o código aparece apenas no console do servidor (modo dev).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="PsycheLink <no-reply@seudominio.com>"

# Checagem de MX no cadastro ("false" desliga)
VALIDAR_MX="true"

PORT=3000

# Chave de criptografia AES-256-GCM dos campos sensíveis (diário, gatilhos, anotações).
# Obrigatória: o servidor não sobe sem ela. 32 bytes em base64.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Origens permitidas no CORS, separadas por vírgula (ex.: a plataforma web).
ALLOWED_ORIGINS="http://localhost:5173"
