# PostgreSQL / Neon. Em produção use o CA da sua infraestrutura quando disponível.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Gere segredos distintos e aleatórios: por exemplo, openssl rand -base64 48
JWT_SECRET="substitua-por-um-segredo-com-no-minimo-32-caracteres"
EMAIL_VERIFICATION_PEPPER="substitua-por-outro-segredo-com-no-minimo-32-caracteres"

PORT=3000
NODE_ENV=development
TRUST_PROXY=false
BCRYPT_ROUNDS=12

# Origens web autorizadas, separadas por vírgula. Obrigatório em produção.
APP_ORIGINS="https://app.psychelink.example"

# Opcional. true rejeita domínios sem registro MX explícito; o OTP ainda é a prova final.
VERIFY_EMAIL_MX=false

# Produção: envio transacional HTTP pela Resend (não use SMTP RCPT TO).
RESEND_API_KEY=""
EMAIL_FROM="PsycheLink <contato@psychelink.example>"
