# Conexão da aplicação (no Neon, o endpoint com -pooler). Use sslmode=verify-full:
# o certificado do servidor é verificado; sem sslmode a conexão não usa TLS.
DATABASE_URL=""

# Conexão direta (sem pooler) usada por `npm run migrar`. Se ausente, cai em DATABASE_URL.
DATABASE_URL_DIRETA=""

# Em produção use "production". O código OTP só aparece no console fora de produção e sem SMTP_HOST.
NODE_ENV=""

# Chave secreta longa e complexa para o JWT
JWT_SECRET=""

# String aleatória usada como pepper no hash dos códigos OTP de e-mail
EMAIL_PEPPER=""

# SMTP para envio dos códigos (Gmail c/ senha de app, Resend, Brevo...).
# Sem SMTP_HOST nada é enviado e, fora de produção, o código aparece no console do servidor.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="PsycheLink <no-reply@seudominio.com>"

# Checagem de MX no cadastro ("false" desliga)
VALIDAR_MX="true"

PORT=3000

# Chave de criptografia AES-256-GCM dos campos sensíveis (diário, gatilhos, anotações).
# Obrigatória: o servidor não sobe sem ela. 32 bytes em base64.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Origens permitidas no CORS, separadas por vírgula (ex.: a plataforma web).
# Sem esta variável nenhuma origem cross-site é liberada (o app mobile nativo não depende de CORS).
ALLOWED_ORIGINS="http://localhost:5173"

# Origens do navegador aceitas nas escritas (POST/PUT/PATCH/DELETE) de /auth/psicologo e /psicologo,
# separadas por vírgula. É a defesa de CSRF das rotas com cookie: sem esta variável toda escrita
# dessas rotas é recusada com 403. Use a origem pública da web (a do proxy, não a do servidor).
WEB_ORIGINS="http://localhost:5173"

# Quantos proxies confiáveis existem na frente do servidor (confia no X-Forwarded-For).
# Ausente = nenhum; o rate limit usa o IP da conexão. Ex.: 1 atrás de um reverse proxy.
TRUST_PROXY=""
